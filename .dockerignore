# Keep the build context small and force a clean install inside the image:
# never ship host node_modules or build output into the container.
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

.git
.gitignore
.env
.env.*
.DS_Store

# Not needed inside the image
bruno
infra
k8s
*.md
