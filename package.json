  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
