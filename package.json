{
  "name": "order-fulfillment-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Learning project: Docker/ECR/EKS, ACID, outbox, SNS/SQS, Redis locks, SAGA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
